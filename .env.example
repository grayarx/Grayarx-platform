# === REQUIRED ===
DATABASE_URL=mysql://user:password@host:port/dbname
JWT_SECRET=your-secret-here

# WhatsApp / Meta
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_DEALERSHIP_ID=1
# Ops-only: never leave enabled in production without a reason
# ALLOW_WHATSAPP_SIGNATURE_BYPASS=1
# ALLOW_WHATSAPP_DIAGNOSTIC=1
# WHATSAPP_DIAGNOSTIC_KEY=separate-from-verify-token

# Email
RESEND_API_KEY=re_your-resend-key
RESEND_INBOUND_WEBHOOK_SECRET=your-secret

# App
APP_URL=https://www.grayarx.com
VITE_APP_ID=grayarx
OWNER_OPEN_ID=your-owner-id

# === OPTIONAL / ENHANCED FEATURES ===
# LLM
OPENAI_API_KEY=sk-your-openai-key
# Default / pilot (starter) model
OPENAI_MODEL=gpt-4o-mini
# Growth (professional) tier — keep mini for cost control
OPENAI_MODEL_GROWTH=gpt-4o-mini
# Multi-site (enterprise) — stronger model optional
OPENAI_MODEL_PREMIUM=gpt-4o
# Legacy Forge: storage/notifications only if S3 not configured — NOT used for chat/LLM
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=
# Chat is OpenAI-only; unused unless you revive a non-OpenAI path
# LLM_MODEL=gemini-2.5-flash

# Stripe (optional — bank/EFT invoices work without these)
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Public success/cancel URLs use APP_URL

# Platform EFT / bank transfer (GrayArx subscription invoices)
# Set real values on Railway Variables — do NOT put the live account number in git.
BANK_NAME=FNB
BANK_ACCOUNT_NAME=GrayArx (Pty) Ltd
BANK_ACCOUNT_NUMBER=your-fnb-account-number
# Common FNB universal branch for SA business — founder must confirm with FNB
BANK_BRANCH_CODE=250655

# Photo storage (Cloudflare R2 / S3-compatible)
S3_BUCKET_NAME=your-bucket
S3_REGION=auto
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_PUBLIC_URL=https://pub-xxx.r2.dev

# Background removal
REMOVE_BG_API_KEY=your-removebg-key

# SMS (Twilio - optional)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_API_KEY=your-key
TWILIO_PHONE_NUMBER=+27xxxxxxxxx

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-secret

# Gmail fallback
EMAIL_USER=grayarx@gmail.com
EMAIL_PASSWORD=your-app-password

# Alerts
FOUNDER_ALERT_EMAIL=founder@grayarx.com
OWNER_EMAIL=owner@grayarx.com
