import { useEffect, useState } from "react";
import { useRoute, useLocation } from "wouter";
import { Button } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { trpc } from "@/lib/trpc";
import { AlertCircle, Search, ArrowLeft } from "lucide-react";

interface SimilarVehicle {
  id: number;
  make: string;
  model: string;
  year: number;
  price: number;
  image?: string;
}

export default function VehicleNotFound() {
  const [, setLocation] = useLocation();
  const [searchQuery, setSearchQuery] = useState("");
  const [suggestedVehicles, setSuggestedVehicles] = useState<SimilarVehicle[]>([]);

  // Get list of available vehicles for suggestions
  const { data: vehicles } = trpc.showroom.list.useQuery();

  useEffect(() => {
    if (vehicles && vehicles.length > 0) {
      // Show first 3 vehicles as suggestions
      setSuggestedVehicles(vehicles.slice(0, 3) as SimilarVehicle[]);
    }
  }, [vehicles]);

  const handleSearch = (e: React.FormEvent) => {
    e.preventDefault();
    if (searchQuery.trim()) {
      setLocation(`/showroom?search=${encodeURIComponent(searchQuery)}`);
    }
  };

  const handleGoBack = () => {
    setLocation("/showroom");
  };

  return (
    <div className="min-h-screen bg-gradient-to-b from-background to-muted/20">
      {/* Header with breadcrumb */}
      <div className="border-b border-border/50 bg-background/50 backdrop-blur-sm sticky top-0 z-40">
        <div className="container mx-auto px-4 py-4">
          <button
            onClick={handleGoBack}
            className="flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors"
          >
            <ArrowLeft className="w-4 h-4" />
            Back to Showroom
          </button>
        </div>
      </div>

      {/* Main content */}
      <div className="container mx-auto px-4 py-16">
        {/* Error section */}
        <div className="max-w-2xl mx-auto mb-16">
          <div className="flex justify-center mb-6">
            <div className="w-20 h-20 rounded-full bg-destructive/10 flex items-center justify-center">
              <AlertCircle className="w-10 h-10 text-destructive" />
            </div>
          </div>

          <h1 className="text-4xl font-bold text-center mb-4">Vehicle Not Found</h1>
          <p className="text-center text-muted-foreground text-lg mb-8">
            We couldn't find the vehicle you're looking for. It may have been sold, archived, or the link might be
            incorrect.
          </p>

          {/* Search section */}
          <Card className="p-6 mb-8 border border-border/50">
            <h2 className="text-lg font-semibold mb-4">Search Our Inventory</h2>
            <form onSubmit={handleSearch} className="flex gap-2">
              <div className="flex-1 relative">
                <Search className="absolute left-3 top-3 w-4 h-4 text-muted-foreground" />
                <Input
                  type="text"
                  placeholder="Search by make, model, year..."
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                  className="pl-10"
                />
              </div>
              <Button type="submit" className="px-8">
                Search
              </Button>
            </form>
          </Card>

          {/* Browse all button */}
          <div className="text-center mb-12">
            <Button onClick={handleGoBack} variant="outline" size="lg" className="px-8">
              Browse All Vehicles
            </Button>
          </div>
        </div>

        {/* Suggested vehicles */}
        {suggestedVehicles.length > 0 && (
          <div className="max-w-6xl mx-auto">
            <h2 className="text-2xl font-bold mb-8">Similar Vehicles You Might Like</h2>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
              {suggestedVehicles.map((vehicle) => (
                <Card
                  key={vehicle.id}
                  className="overflow-hidden hover:shadow-lg transition-shadow cursor-pointer border border-border/50"
                  onClick={() => setLocation(`/showroom/${vehicle.id}`)}
                >
                  {vehicle.image && (
                    <div className="w-full h-48 bg-muted overflow-hidden">
                      <img src={vehicle.image} alt={`${vehicle.make} ${vehicle.model}`} className="w-full h-full object-cover" />
                    </div>
                  )}
                  <div className="p-4">
                    <h3 className="font-semibold text-lg mb-2">
                      {vehicle.year} {vehicle.make} {vehicle.model}
                    </h3>
                    <p className="text-2xl font-bold text-primary mb-4">
                      R {vehicle.price.toLocaleString("en-ZA")}
                    </p>
                    <Button className="w-full" variant="outline">
                      View Details
                    </Button>
                  </div>
                </Card>
              ))}
            </div>
          </div>
        )}

        {/* Help section */}
        <div className="max-w-2xl mx-auto mt-16 pt-12 border-t border-border/50">
          <h3 className="text-lg font-semibold mb-4">Need Help?</h3>
          <p className="text-muted-foreground mb-4">
            If you believe this is an error or need assistance finding a specific vehicle, please contact our sales team.
          </p>
          <div className="flex gap-4">
            <Button variant="outline">Contact Sales</Button>
            <Button variant="outline">Browse by Make</Button>
          </div>
        </div>
      </div>
    </div>
  );
}
